_package() {
  mkdir -p "${pkgdir}/opt/zextras/bin/"
  mkdir -p "${pkgdir}/opt/zextras/conf/templates/"
  mkdir -p "${pkgdir}/opt/zextras/jetty_base/etc/"
  mkdir -p "${pkgdir}/opt/zextras/jetty_base/common/endorsed/"
  mkdir -p "${pkgdir}/opt/zextras/jetty_base/common/lib/"
  mkdir -p "${pkgdir}/opt/zextras/jetty_base/webapps/zimbra/"
  mkdir -p "${pkgdir}/opt/zextras/cache/"
  mkdir -p "${pkgdir}/opt/zextras/incoming/"
  mkdir -p "${pkgdir}/opt/zextras/lib/jars/"

  cd "${srcdir}/.."

  install -D conf/antisamy.xml \
    "${pkgdir}/opt/zextras/conf/antisamy.xml"

  install -D conf/owasp_policy.xml \
    "${pkgdir}/opt/zextras/conf/owasp_policy.xml"

  install -D conf/hotspot_compiler \
    "${pkgdir}/opt/zextras/log/.hotspot_compiler"

  ln -sf /opt/zextras/jetty_base \
    "${pkgdir}/opt/zextras/jetty"

  ln -sf /opt/zextras/jetty_base \
    "${pkgdir}/opt/zextras/mailboxd"

  # systemd tmpfiles.d
  install -Dm644 "${srcdir}/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
}

_package_systemd() {
  # systemd units and target
  install -Dm 644 "${srcdir}/${pkgname}.target" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.target"

  install -Dm644 "${srcdir}/carbonio-appserver-log-cleanup.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-appserver-log-cleanup.service"

  install -Dm644 "${srcdir}/carbonio-appserver-log-cleanup.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-appserver-log-cleanup.timer"

  install -Dm644 "${srcdir}/carbonio-appserver-db-integrity-report.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-appserver-db-integrity-report.service"

  install -Dm644 "${srcdir}/carbonio-appserver-db-integrity-report.timer" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-appserver-db-integrity-report.timer"
}

_postinst() {
  H=$(hostname -s)

  if [ -f /opt/zextras/db/db.sql ]; then
    mv /opt/zextras/db/db.sql /opt/zextras/db/db.sql.in
    sed -e "/server.hostname/ s/local/$H/" /opt/zextras/db/db.sql.in >/opt/zextras/db/db.sql
  fi

  systemd-tmpfiles --create /usr/lib/tmpfiles.d/carbonio-appserver.conf >/dev/null 2>&1 || :
}

_postinst_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable carbonio-appserver.target &>/dev/null || :
    systemctl enable carbonio-appserver.service &>/dev/null || :
    systemctl enable carbonio-appserver-db.service &>/dev/null || :
    systemctl enable carbonio-appserver-log-cleanup.timer carbonio-appserver-db-integrity-report.timer &>/dev/null || :
    if systemctl -q is-active carbonio-appserver.target; then
      systemctl start carbonio-appserver-log-cleanup.timer carbonio-appserver-db-integrity-report.timer &>/dev/null || :
    fi
  fi
}

_postrm_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
  fi
}

_prerm_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now carbonio-appserver-log-cleanup.timer carbonio-appserver-db-integrity-report.timer &>/dev/null || :
    systemctl --no-reload disable --now carbonio-appserver.target &>/dev/null || :
  fi
}

package() {
  _package
  _package_systemd
}

package__rocky_8() {
  _package
}

package__rocky_9() {
  _package
  _package_systemd
}

package__ubuntu_jammy() {
  _package
}

package__ubuntu_noble() {
  _package
  _package_systemd
}

postinst__rocky_8() {
  _postinst
}

postinst__rocky_9() {
  _postinst
  _postinst_systemd
}

postinst__ubuntu_jammy() {
  _postinst
}

postinst__ubuntu_noble() {
  _postinst
  _postinst_systemd
}

postrm__rocky_9() {
  _postrm_systemd
}

postrm__ubuntu_noble() {
  _postrm_systemd
}

# TODO: this preinst will be dropped in 26.09
preinst() {
  if [ -d "/opt/zextras/jetty" ]; then
    rm -rf /opt/zextras/jetty >/dev/null 2>&1
  fi

  if [ -d "/opt/zextras/mailboxd" ]; then
    rm -rf /opt/zextras/mailboxd >/dev/null 2>&1
  fi

  if [ -d "/opt/zextras/mailboxd/work/zimbra" ]; then
    rm -rf /opt/zextras/mailboxd/work/zimbra >/dev/null 2>&1
  fi

  if [ -d "/opt/zextras/mailboxd/work/zimbraAdmin" ]; then
    rm -rf /opt/zextras/mailboxd/work/zimbraAdmin >/dev/null 2>&1
  fi
}

prerm__rocky_9() {
  _prerm_systemd
}

prerm__ubuntu_noble() {
  _prerm_systemd
}
