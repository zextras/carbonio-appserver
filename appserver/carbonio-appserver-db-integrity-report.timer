[Unit]
Description=Carbonio Appserver DB Integrity Report Weekly
Documentation=https://docs.zextras.com/
PartOf=carbonio-appserver.target

[Timer]
OnCalendar=Sun *-*-* 23:00:00
Persistent=true

[Install]
WantedBy=carbonio-appserver.target
